{
  "name": "blyx-language",
  "displayName": "BLYX Language",
  "description": "Official VS Code language support for the Blyx programming language (https://blyx-lang.space) created by Rahul Chaube.",
  "version": "1.1.0",
  "publisher": "RahulChaube",
  "license": "MIT",
  "icon": "blyx.png",
  "homepage": "https://blyx-lang.space",
  "repository": {
    "type": "git",
    "url": "https://github.com/Blyx-lang-space/blyx.git"
  },
  "bugs": {
    "url": "https://github.com/Blyx-lang-space/blyx/issues"
  },
  "keywords": [
    "blyx",
    "programming-language",
    "compiler",
    "systems",
    "llvm",
    "gpu",
    "tensor",
    "actor",
    "ai",
    "language"
  ],
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters",
    "Debuggers",
    "Snippets"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./src/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "blyx",
        "aliases": [
          "BLYX",
          "Blyx",
          "blyx"
        ],
        "extensions": [
          ".blyx"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "blyx",
        "scopeName": "source.blyx",
        "path": "./syntaxes/blyx.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "blyx",
        "path": "./snippets/blyx.json"
      }
    ]
  }
}
