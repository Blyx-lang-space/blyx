{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Blyx",
  "patterns": [
    {
      "include": "#keywords"
    },
    {
      "include": "#strings"
    }
  ],
  "repository": {
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.blyx",
          "match": "\\b(if|else|match|loop|while|for|in|break|continue|return|async|await|parallel|gpu)\\b"
        },
        {
          "name": "keyword.other.blyx",
          "match": "\\b(fn|let|mut|const|static|struct|enum|trait|impl|type|actor|tensor|kernel|use|pub|mod)\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.blyx",
      "begin": "\"",
      "end": "\""
    }
  },
  "scopeName": "source.blyx"
}
